# Переменные окружения бэкенда (Go / Gin). Скопируйте в .env репозитория бэка.

# Порт HTTP-сервера (фронт в деве ждёт 8080)
PORT=8080

# Строка подключения к PostgreSQL.
# В docker-compose host = "db"; локально без Docker — "localhost".
DATABASE_URL=postgres://dfp:dfp_password@db:5432/dance_feedback?sslmode=disable

# Секрет для подписи JWT (в проде — длинный случайный, хранить в секретах хостинга)
JWT_SECRET=change-me-in-prod

# Время жизни токенов (пример; подставьте под вашу реализацию)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# CORS: разрешённые origin фронта через запятую (дев + прод-домен Vercel)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://dancefeedbackplatform.vercel.app
